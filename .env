// lib/core/config/api_config.dart
import 'package:flutter_dotenv/flutter_dotenv.dart';
import 'package:flutter/material.dart';


class ApiConfig {
  static String get baseUrl => dotenv.env['BASE_API_URL'] ?? 'http://127.0.0.1:8000/api';

  // Authentication endpoints
  static Uri get registerUrl => Uri.parse('$baseUrl/register');
  static Uri get loginUrl => Uri.parse('$baseUrl/login');
  static Uri get updateUrl => Uri.parse('$baseUrl/update');
  static Uri get deleteUrl => Uri.parse('$baseUrl/delete');

  // Banner endpoints
  static Uri get bannersUrl => Uri.parse('$baseUrl/banners');
  static Uri bannerDetailsUrl(int id) => Uri.parse('$baseUrl/banners/$id');
  static Uri bannerPostsUrl(int id) => Uri.parse('$baseUrl/banners/$id/posts');
}